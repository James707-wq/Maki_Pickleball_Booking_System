MONGO_URI=mongodb://127.0.0.1:27017/makis_pickleball
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5000
# Comma-separated origins allowed to call the API when the frontend is hosted separately.
# Falls back to CLIENT_URL when unset.
# CORS_ORIGINS=http://localhost:5500,https://www.example.com
# Set on the live server. Then admin one-time codes are never printed in the server console,
# so set up email (7. below) first.
# NODE_ENV=production
# How long a sign-in lasts (default 7d). Every sign-in is a session: signing out ends it on the server, and admins
# see and end sessions under Security -> Active sessions. Changing JWT_SECRET signs everyone out.
# JWT_EXPIRES_IN=7d
# Where backups are saved (default backend/backups, which git ignores). Admin -> Data -> Backup & restore.
# A path relative to backend/, or a full path. Never inside frontend/: anyone could download them from there.
# BACKUP_DIR=../private-backups

# Rate limits: how many requests one person or address may make in a time window before the server
# answers 429 "Too many requests". Format: <requests>/<window>, the window in s, m or h
# (30/15m = 30 per 15 minutes); "off" turns one off. Leave them out to use these defaults.
# Signed-in people are counted by account, everyone else by IP address. Admins see the limits and who
# was refused under Security -> Login security; GET /api/rate-limit shows anyone where they stand.
# Sign-in, sign-up, password reset and Google sign-in (per IP address):
# RATE_LIMIT_AUTH=30/15m
# Every other API request:
# RATE_LIMIT_API=300/1m
# Making bookings, payment proofs and payment links, feedback, support messages, broadcasts and announcements:
# RATE_LIMIT_CREATE=20/10m
# On the live server behind a proxy or load balancer (Render, Railway, Nginx...): how many are in front of
# the server, so each visitor's real IP address is used. Without it everyone shares the proxy's address,
# and so one rate limit. Never "true": then visitors could make up their own address.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Optional integrations (admin). Each one switches on when its keys are set;
# leave them blank and the admin console works without them.
# Status and on/off switches: admin -> Integrations (sidebar). Turning one on or off asks for
# the admin's security PIN, then a one-time code sent by email (see 7.).
# ---------------------------------------------------------------------------

# 1. Google Sign-In for staff/admin (Google Cloud Console -> APIs & Services -> Credentials ->
#    OAuth client ID, type "Web application"; add your site, e.g. http://localhost:5000, to
#    "Authorized JavaScript origins"). Staff sign in with the Google account matching their staff email.
#    Customers use it too ("Continue with Google" on the login and sign-up pages), unless CUSTOM_GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
#    Optional: a second OAuth client ID just for customers (made the same way, with the same origins), e.g. so Google's
#    sign-in screen shows the customer site's own name and logo. Leave it blank to use GOOGLE_CLIENT_ID for everyone.
CUSTOM_GOOGLE_CLIENT_ID=

# 2. Google Calendar: confirmed bookings are mirrored onto this calendar.
#    Create a service account (Google Cloud Console -> IAM -> Service accounts), enable the
#    Google Calendar API, create a JSON key, then share the calendar with the service account's
#    email ("Make changes to events"). Calendar ID is under the calendar's settings.
#    Paste the private key on one line with \n for line breaks, inside double quotes.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 3. Cloudflare Turnstile human check on the admin sign-in form (dash.cloudflare.com -> Turnstile).
#    Testing keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 5. HitPay payment links (GCash, QR Ph, cards, GrabPay, ShopeePay...). Sign up at hitpayapp.com; while testing
#    use a sandbox account (dashboard.sandbox.hit-pay.com). Dashboard -> Settings -> API Keys -> HITPAY_API_KEY.
#    HITPAY_SANDBOX=true for sandbox keys; set it to false with live keys (real payments).
#    For automatic "paid" updates: Developers -> Webhook Endpoints, add https://<your-domain>/api/webhooks/hitpay
#    for the event payment_request.completed and paste that endpoint's salt here (needs a public https site).
#    Without it, a payment is recorded when the customer comes back to their booking, or when staff press
#    "Check payment" on the booking.
HITPAY_API_KEY=
HITPAY_SANDBOX=true
HITPAY_WEBHOOK_SALT=

# 4 and 6 need no keys: the map uses Leaflet + OpenStreetMap and the weather uses Open-Meteo.
# Set the facility location in admin -> Location.

# 7. Email: booking emails, password resets, and the admins' one-time codes + change alerts for Integrations.
#    Recommended: Resend (resend.com, free tier) with your verified domain.
#    Or SMTP (e.g. Gmail with an App Password): leave RESEND_API_KEY blank and fill EMAIL_HOST/PORT/USER/PASS.
#    With no email at all, admin one-time codes are printed in the server console (development only).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# 8. QR check-in needs no keys: confirmed bookings show a QR code; staff scan it under admin -> Check-ins.

# 9. Custom API (webhook) needs no keys here: set the address of your system and its signing secret under
#    admin -> Integrations -> Custom API. The secret is stored encrypted with a key made from JWT_SECRET, so if
#    you change JWT_SECRET, make a new webhook secret there.
